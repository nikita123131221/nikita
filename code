-- SAFE JSON DECODE FUNCTION with error handling
local function safeJSONDecode(jsonString)
    -- Check if input is a string
    if type(jsonString) ~= "string" then
        warn("safeJSONDecode: Input is not a string, got " .. type(jsonString))
        return nil
    end
    
    -- Check if string is empty
    if #jsonString == 0 then
        warn("safeJSONDecode: Empty string provided")
        return nil
    end
    
    -- Basic validation - JSON must start with { or [
    local firstChar = string.sub(jsonString, 1, 1)
    if firstChar ~= "{" and firstChar ~= "[" then
        warn("safeJSONDecode: Invalid JSON format - doesn't start with { or [, got: " .. firstChar)
        warn("First 100 characters: " .. string.sub(jsonString, 1, 100))
        return nil
    end
    
    -- Attempt to decode with pcall
    local success, result = pcall(function()
        return HttpService:JSONDecode(jsonString)
    end)
    
    if not success then
        warn("safeJSONDecode: JSON decoding failed - " .. tostring(result))
        warn("Problematic string preview: " .. string.sub(jsonString, 1, 200))
        return nil
    end
    
    -- Validate the decoded result is a table
    if type(result) ~= "table" then
        warn("safeJSONDecode: Decoded result is not a table, got " .. type(result))
        return nil
    end
    
    return result
end

-- Function to safely fetch and decode from URL
local function safeFetchAndDecode(url)
    if type(url) ~= "string" or #url == 0 then
        warn("safeFetchAndDecode: Invalid URL provided")
        return nil
    end
    
    local success, response = pcall(function()
        return HttpService:GetAsync(url)
    end)
    
    if not success then
        warn("safeFetchAndDecode: Failed to fetch URL - " .. tostring(response))
        return nil
    end
    
    if type(response) ~= "string" or #response == 0 then
        warn("safeFetchAndDecode: Empty or invalid response")
        return nil
    end
    
    return safeJSONDecode(response)
end

-- Example: Fetching from GitHub safely
local function fetchFromGitHubSafe(repoUrl)
    local data = safeFetchAndDecode(repoUrl)
    
    if data == nil then
        warn("Failed to fetch or decode data from GitHub")
        return nil
    end
    
    -- Additional validation based on expected structure
    if type(data) == "table" then
        -- Check if it's an array (has numeric indices)
        local isArray = false
        for key in pairs(data) do
            if type(key) == "number" then
                isArray = true
            end
            break
        end
        
        if not isArray then
            warn("Data is not a JSON array, it's a dictionary/object")
        end
        
        return data
    end
    
    return nil
end

-- Alternative: Validate that data matches expected schema
local function validateWordList(data)
    -- Expected format: array of strings like {"word1", "word2", "word3"}
    if type(data) ~= "table" then
        return false, "Data is not a table"
    end
    
    local isArray = true
    local index = 1
    for key, value in pairs(data) do
        if key ~= index then
            isArray = false
            break
        end
        if type(value) ~= "string" then
            return false, "Array element " .. index .. " is not a string (got " .. type(value) .. ")"
        end
        index = index + 1
    end
    
    if not isArray then
        return false, "Data is not a sequential array (has non-numeric keys)"
    end
    
    return true, "Valid word list"
end

-- Usage example with proper validation
local function loadWordListFromGitHub(url)
    local data = safeFetchAndDecode(url)
    
    if not data then
        return nil, "Failed to load data"
    end
    
    local isValid, message = validateWordList(data)
    if not isValid then
        warn("Word list validation failed: " .. message)
        return nil, message
    end
    
    print("Successfully loaded " .. #data .. " words")
    return data, "Success"
end

